      "source": [
        "# Ejemplo con secuencia simulada (reemplazar con secuencia real de gen)\n",
        "print(\"=\"*70)\n",
        "print(\"EJEMPLO: PREDICCIÓN EN GEN DE INTERÉS\")\n",
        "print(\"=\"*70)\n",
        "\n",
        "# Secuencia simulada (en la práctica, cargar desde FASTA)\n",
        "# Reemplazar con secuencia real de BRCA1, TP53, etc.\n",
