        "        seq, label = train_dataset[i]\n",
        "        if label == 1:\n",
        "            print(f\"Usando muestra {i}\")\n",
        "            break"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "integrated-gradients-section"
      },
      "source": [
        "<a id='integrated-gradients'></a>\n",
        "## 9. Integrated Gradients\n",
        "\n",
        "Integrated Gradients es un método de atribución que proporciona asignaciones más robustas que los Saliency Maps simples.\n",
        "\n",
        "**Referencia:** Sundararajan et al. (2017). Axiomatic attribution for deep networks. *Proceedings of the 34th International Conference on Machine Learning*, 70, 3319–3328."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "integrated-gradients-compute"
      },
      "source": [
        "def integrated_gradients(modelo, sequence_tensor, device='cpu', n_steps=50):\n",
        "    \"\"\"\n",
        "    Calcula Integrated Gradients para una secuencia.\n",
        "\n",
        "    Args:\n",
        "        modelo: Modelo entrenado\n",
        "        sequence_tensor: Tensor de entrada (200, 4)\n",
        "        device: 'cuda' o 'cpu'\n",
        "        n_steps: Número de pasos para la integración\n",
        "\n",
        "    Returns:\n",
        "        ig_attribution: Atribuciones de Integrated Gradients (200, 4)\n",
        "    \"\"\"\n",
        "    modelo.eval()\n",
        "    modelo.to(device)\n",
        "\n",
        "    # Baseline: secuencia de ceros\n",
        "    baseline = torch.zeros_like(sequence_tensor)\n",
        "\n",
        "    # Interpolaciones\n",
        "    alphas = np.linspace(0, 1, n_steps)\n",
        "\n",
        "    # Añadir dimensión de batch\n",
        "    sequence_tensor = sequence_tensor.to(device)\n",
        "\n",
        "    # Acumular gradientes\n",
        "    gradients_sum = torch.zeros_like(sequence_tensor)\n",
        "\n",
        "    for alpha in alphas:\n",
        "        # Interpolación\n",
        "        interpolated = baseline + alpha * (sequence_tensor - baseline)\n",
        "        interpolated.requires_grad = True\n",
        "\n",
        "        # Forward pass\n",
        "        output = modelo(interpolated.unsqueeze(0)).squeeze()\n",
        "\n",
        "        # Backward pass\n",
        "        output.backward()\n",
        "\n",
        "        # Acumular gradientes\n",
        "        gradients_sum += interpolated.grad.detach()\n",
        "\n",
        "    # Integrated Gradients = (x - x') * promedio(gradientes)\n",
        "    ig_attribution = (sequence_tensor - baseline) * (gradients_sum / n_steps)\n",
        "\n",
        "    return ig_attribution.cpu().detach().numpy()\n",
        "\n",
        "\n",
        "print(\"✓ Función de Integrated Gradients definida\")"
      ]
    },
