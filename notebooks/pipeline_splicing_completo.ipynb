    {
      "cell_type": "markdown",
      "metadata": {
        "id": "pwm-section"
      },
      "source": [
        "<a id='pwm'></a>\n",
        "## 10. Extracción de Position Weight Matrices (PWMs)\n",
        "\n",
        "Los pesos de la primera capa convolucional pueden interpretarse como motivos de secuencia. Transformamos estos pesos en Position Weight Matrices (PWMs) para visualizarlos como logos de secuencia."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "pwm-extraction"
      },
      "source": [
        "def extract_pwm_from_conv_weights(modelo, filter_idx=0):\n",
        "    \"\"\"\n",
        "    Extrae una PWM de los pesos de un filtro convolucional.\n",
        "\n",
        "    Args:\n",
        "        modelo: Modelo entrenado\n",
        "        filter_idx: Índice del filtro a extraer\n",
        "\n",
        "    Returns:\n",
        "        pwm: Position Weight Matrix (kernel_size, 4)\n",
        "    \"\"\"\n",
        "    # Obtener pesos de la primera capa convolucional\n",
        "    conv1_weights = modelo.conv1.weight.detach().cpu().numpy()\n",
        "\n",
        "    # Shape: (filtros, 4, kernel_size)\n",
        "    # Extraer filtro específico\n",
        "    filter_weights = conv1_weights[filter_idx]  # (4, kernel_size)\n",
        "\n",
        "    # Transponer a (kernel_size, 4)\n",
        "    pwm = filter_weights.T\n",
        "\n",
        "    return pwm\n",
        "\n",
        "\n",
        "def normalize_pwm(pwm):\n",
        "    \"\"\"\n",
        "    Normaliza PWM para que cada posición sume 1 (frecuencias).\n",
        "\n",
        "    Args:\n",
        "        pwm: Position Weight Matrix (L, 4)\n",
        "\n",
        "    Returns:\n",
        "        pwm_normalized: Frecuencias normalizadas\n",
        "    \"\"\"\n",
        "    # Aplicar softmax por posición\n",
        "    from scipy.special import softmax\n",
        "    pwm_normalized = softmax(pwm, axis=1)\n",
        "    return pwm_normalized\n",
        "\n",
        "\n",
        "print(\"✓ Funciones de extracción de PWM definidas\")"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "pwm-visualization"
      },
      "source": [
        "# Visualizar PWMs de los primeros filtros\n",
        "print(\"=\"*70)\n",
        "print(\"VISUALIZACIÓN DE PWMs DE FILTROS CONVOLUCIONALES\")\n",
        "print(\"=\"*70)\n",
        "\n",
        "# Intentar usar logomaker si está disponible\n",
        "try:\n",
