        "id": "genes-section"
      },
      "source": [
        "<a id='genes'></a>\n",
        "## 11. Aplicación a Genes de Interés\n",
        "\n",
        "El modelo entrenado puede aplicarse a secuencias de genes específicos para identificar posibles sitios alternativos no anotados."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "gene-prediction"
      },
      "source": [
        "def predict_gene_sequence(modelo, secuencia_genetica, window_size=200, step=50, device='cpu'):\n",
        "    \"\"\"\n",
        "    Aplica el modelo a una secuencia genética larga usando ventana deslizante.\n",
        "\n",
        "    Args:\n",
        "        modelo: Modelo entrenado\n",
        "        secuencia_genetica: Secuencia de ADN larga\n",
        "        window_size: Tamaño de ventana (default: 200)\n",
        "        step: Paso de la ventana deslizante (default: 50)\n",
        "        device: 'cuda' o 'cpu'\n",
        "\n",
        "    Returns:\n",
        "        predictions: Lista de predicciones\n",
        "        positions: Posiciones centrales de cada ventana\n",
        "    \"\"\"\n",
        "    modelo.eval()\n",
        "    modelo.to(device)\n",
        "\n",
        "    secuencia_genetica = secuencia_genetica.upper().strip()\n",
        "    predictions = []\n",
        "    positions = []\n",
        "\n",
        "    with torch.no_grad():\n",
        "        for i in range(0, len(secuencia_genetica) - window_size + 1, step):\n",
        "            ventana = secuencia_genetica[i:i+window_size]\n",
        "            center_pos = i + window_size // 2\n",
        "\n",
        "            # Codificar\n",
        "            seq_tensor = codificar_one_hot(ventana, window_size)\n",
        "            seq_tensor = seq_tensor.unsqueeze(0).to(device)\n",
        "\n",
        "            # Predicción\n",
        "            pred = modelo(seq_tensor).squeeze().cpu().numpy()\n",
        "\n",
        "            predictions.append(pred)\n",
        "            positions.append(center_pos)\n",
        "\n",
        "    return np.array(predictions), np.array(positions)\n",
        "\n",
        "\n",
        "def visualize_gene_predictions(predictions, positions, threshold=0.5):\n",
        "    \"\"\"\n",
        "    Visualiza predicciones a lo largo de una secuencia genética.\n",
        "\n",
        "    Args:\n",
        "        predictions: Array de predicciones\n",
        "        positions: Posiciones centrales\n",
        "        threshold: Umbral para considerar sitio positivo\n",
        "    \"\"\"\n",
        "    fig, ax = plt.subplots(figsize=(14, 4))\n",
        "\n",
        "    ax.plot(positions, predictions, 'b-', linewidth=1, label='Probabilidad')\n",
        "    ax.axhline(y=threshold, color='red', linestyle='--', linewidth=2, label=f'Umbral ({threshold})')\n",
        "\n",
        "    # Marcar predicciones positivas\n",
        "    positive_idx = np.where(predictions >= threshold)[0]\n",
        "    if len(positive_idx) > 0:\n",
        "        ax.scatter(positions[positive_idx], predictions[positive_idx],\n",
        "                  color='red', s=50, alpha=0.7, label='Sitios positivos')\n",
        "\n",
        "    ax.set_xlabel('Posición en el gen')\n",
        "    ax.set_ylabel('Probabilidad de sitio de splicing')\n",
        "    ax.set_title('Predicción de Sitios de Splicing en Secuencia Genética')\n",
        "    ax.legend()\n",
        "    ax.grid(True, alpha=0.3)\n",
        "    ax.set_ylim([0, 1.1])\n",
        "\n",
        "    plt.tight_layout()\n",
        "    plt.savefig('/content/drive/MyDrive/gene_predictions.png', dpi=150)\n",
        "    plt.show()\n",
        "\n",
        "    print(f\"\\n✓ Total de sitios positivos detectados: {len(positive_idx)}\")\n",
        "\n",
        "    return positive_idx\n",
        "\n",
        "\n",
        "print(\"✓ Funciones para predicción en genes definidas\")"
      ]
    },
