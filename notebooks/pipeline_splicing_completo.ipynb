        "    axes[0].axvline(x=100, color='red', linestyle='--', linewidth=2, label='Sitio de Splicing')\n",
        "    axes[0].set_xlabel('Posición en la secuencia')\n",
        "    axes[0].set_ylabel('Importancia (Saliency)')\n",
        "    axes[0].set_title('Saliency Map - Importancia por Posición')\n",
        "    axes[0].legend()\n",
        "    axes[0].grid(True, alpha=0.3)\n",
        "\n",
        "    # Heatmap de saliencia por nucleótido\n",
        "    im = axes[1].imshow(saliency.T, aspect='auto', cmap='YlOrRd')\n",
        "    axes[1].set_xlabel('Posición en la secuencia')\n",
        "    axes[1].set_ylabel('Nucleótido')\n",
        "    axes[1].set_yticks([0, 1, 2, 3])\n",
        "    axes[1].set_yticklabels(['A', 'C', 'G', 'T'])\n",
        "    axes[1].set_title('Saliency Map por Nucleótido')\n",
