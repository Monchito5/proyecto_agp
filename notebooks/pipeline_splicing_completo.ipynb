        "id": "saliency-section"
      },
      "source": [
        "<a id='saliency'></a>\n",
        "## 8. Saliency Maps - Interpretación del Modelo\n",
        "\n",
        "Los Saliency Maps calculan el gradiente de la salida del modelo respecto a los nucleótidos de entrada, identificando las posiciones más críticas para la predicción.\n",
        "\n",
        "**Referencia:** Simonyan et al. (2013). Deep inside convolutional networks: Visualising image classification models and saliency maps. *arXiv preprint arXiv:1312.6034*."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "saliency-compute"
      },
      "source": [
        "def compute_saliency_maps(modelo, sequence_tensor, device='cpu'):\n",
        "    \"\"\"\n",
        "    Calcula Saliency Maps para una secuencia individual.\n",
        "\n",
        "    Args:\n",
        "        modelo: Modelo entrenado\n",
        "        sequence_tensor: Tensor de entrada (200, 4)\n",
        "        device: 'cuda' o 'cpu'\n",
        "\n",
        "    Returns:\n",
        "        saliency_map: Gradientes absolutos (200, 4)\n",
        "    \"\"\"\n",
        "    modelo.eval()\n",
        "    modelo.to(device)\n",
        "\n",
        "    # Añadir dimensión de batch\n",
        "    x = sequence_tensor.unsqueeze(0).to(device)\n",
        "    x.requires_grad = True\n",
        "\n",
        "    # Forward pass\n",
        "    output = modelo(x).squeeze()\n",
        "\n",
        "    # Backward pass - calcular gradientes respecto a la entrada\n",
        "    output.backward()\n",
        "\n",
        "    # Obtener gradientes absolutos\n",
        "    saliency_map = torch.abs(x.grad).cpu().detach().numpy()\n",
        "\n",
        "    return saliency_map\n",
        "\n",
        "\n",
        "def aggregate_saliency_by_position(saliency_maps):\n",
        "    \"\"\"\n",
        "    Agrupa salience maps por posición y nucleótido.\n",
        "\n",
        "    Args:\n",
        "        saliency_maps: Lista de arrays (200, 4)\n",
        "\n",
        "    Returns:\n",
        "        avg_saliency: Promedio por posición (200, 4)\n",
        "    \"\"\"\n",
        "    return np.mean(saliency_maps, axis=0)\n",
        "\n",
        "\n",
        "print(\"✓ Funciones de Saliency Maps definidas\")"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "saliency-example"
      },
      "source": [
        "# Ejemplo: Calcular Saliency Map para una secuencia verdadera\n",
        "print(\"=\"*70)\n",
        "print(\"EJEMPLO DE SALIENCY MAP\")\n",
        "print(\"=\"*70)\n",
        "\n",
        "# Obtener una muestra positiva (sitio verdadero)\n",
        "sample_idx = 0\n",
        "seq, label = train_dataset[sample_idx]\n",
        "\n",
        "if label == 1:  # Solo si es positivo\n",
        "    # Calcular Saliency Map\n",
        "    saliency = compute_saliency_maps(modelo_entrenado, seq, DEVICE)\n",
        "\n",
        "    # Obtener secuencia como string\n",
        "    nucleo_map = {0: 'A', 1: 'C', 2: 'G', 3: 'T'}\n",
        "    secuencia_str = ''.join([nucleo_map[np.argmax(seq[i].numpy())] for i in range(200)])\n",
        "\n",
        "    # Calcular importancia por posición (suma sobre canales)\n",
        "    importance_by_pos = np.sum(saliency, axis=1)\n",
        "\n",
        "    # Visualizar\n",
        "    fig, axes = plt.subplots(2, 1, figsize=(14, 8))\n",
        "\n",
